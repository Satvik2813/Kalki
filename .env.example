# ─────────────────────────────────────────────────────────────
# KALKI — environment configuration (copy to .env and fill in)
# Every value has a safe local-first default; KALKI runs fully
# offline with the built-in Mock provider + local SQLite memory.
# ─────────────────────────────────────────────────────────────

# ── Model routing ────────────────────────────────────────────
# Which model provider the core should use.
#   mock       -> deterministic, offline, no network (default; used by tests)
#   omniroute  -> route through an OmniRoute gateway (verify reliability first)
#   anthropic  -> direct Anthropic API
#   openai     -> direct OpenAI API
KALKI_MODEL_PROVIDER=mock
KALKI_MODEL_NAME=claude-sonnet-4

# OmniRoute gateway (only used when KALKI_MODEL_PROVIDER=omniroute)
# Start it with `npm i -g omniroute && omniroute` (boots on :20128).
# The OpenAI-compatible surface lives at <base_url>/v1. For a keyless run set
# KALKI_MODEL_NAME=auto (or felo/auto) — free providers need no key.
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=                 # optional; free providers work keyless
OMNIROUTE_HEALTH_PATH=             # blank -> reachability probe hits /v1/models

# Direct providers (fallbacks — core never depends on OmniRoute)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=               # Uses HF Serverless Inference (api-inference.huggingface.co)

# ── Memory ───────────────────────────────────────────────────
# local    -> SQLite + naive vector index (default, offline, zero-config)
# supabase -> Supabase Postgres + pgvector
KALKI_MEMORY_BACKEND=local
KALKI_LOCAL_DB_PATH=kalki_local.sqlite3

# Supabase (only used when KALKI_MEMORY_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=        # to verify frontend JWTs locally
SUPABASE_DB_URL=            # postgresql://... (direct pgvector connection)
KALKI_EMBEDDING_DIM=384

# ── Execution / safety ───────────────────────────────────────
# Auto-approve safe development actions; gate high-risk ones.
KALKI_AUTONOMY=supervised          # supervised | autonomous
KALKI_MAX_TASK_RETRIES=2
KALKI_MAX_PLAN_REVISIONS=3
KALKI_WORKSPACE_ROOT=.             # sandbox root for filesystem/shell tools

# ── API ──────────────────────────────────────────────────────
KALKI_API_HOST=127.0.0.1
KALKI_API_PORT=8000
KALKI_LOG_LEVEL=INFO
